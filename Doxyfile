# Doxygen reads the API comments of the headers in INPUT and writes XML.
PROJECT_NAME           = mbedded-cbor
INPUT                  = include/cbor/cbor.hpp \
                         include/cbor/item_size.hpp \
                         include/cbor/sequence.hpp \
                         include/cbor/sequence_reader.hpp \
                         include/cbor/diagnostic_notation.hpp \
                         include/cbor/error.hpp \
                         include/cbor/validity.hpp \
                         include/cbor/ref.hpp \
                         include/cbor/describe.hpp \
                         include/cbor/structs.hpp \
                         include/cbor/lazy.hpp \
                         include/cbor/rfc9535.hpp \
                         include/cbor/query.hpp \
                         include/cbor/rfc8949.hpp \
                         include/cbor/schema.hpp \
                         include/cbor/item.hpp \
                         include/cbor/decode.hpp \
                         include/cbor/encode.hpp
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include
EXCLUDE_SYMBOLS        = cbor::detail cbor::detail::* cbor::well_formedness
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = YES
HIDE_FRIEND_COMPOUNDS  = YES
BUILTIN_STL_SUPPORT    = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = CBOR_OWNER= CBOR_LIFETIMEBOUND= CBOR_ALWAYS_INLINE= "__has_include(x)=1"
ALIASES                = "complexity=@par Complexity^^"
EXAMPLE_PATH           = test
QUIET                  = YES
WARN_NO_PARAMDOC       = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = NO
WARN_AS_ERROR          = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
CLANG_ASSISTED_PARSING = YES
CLANG_OPTIONS          = -std=c++26 -Iinclude
