# Doxygen writes the man pages: one page for each group, one for each class, and the overview.
@INCLUDE               = Doxyfile
GENERATE_XML           = NO
GENERATE_MAN           = YES
MAN_EXTENSION          = .3
MAN_LINKS              = NO
LAYOUT_FILE            = tools/man/DoxygenLayout.xml
PROJECT_NUMBER         = $(VERSION)
BRIEF_MEMBER_DESC      = YES
INLINE_GROUPED_CLASSES = NO
SHOW_GROUPED_MEMB_INC  = NO
INLINE_INFO            = NO
SORT_MEMBER_DOCS       = NO
