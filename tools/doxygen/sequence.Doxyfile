PROJECT_NAME = mbedded-cbor
PROJECT_NUMBER = sequence-pilot
OUTPUT_DIRECTORY = $(CBOR_DOXYGEN_OUTPUT)
INPUT = include/cbor/sequence.hpp
FILE_PATTERNS = *.hpp
RECURSIVE = NO
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
HIDE_UNDOC_MEMBERS = YES
HIDE_UNDOC_CLASSES = YES
FULL_PATH_NAMES = NO
EXCLUDE_SYMBOLS = cbor::sequence::iterator::encoded cbor::sequence::iterator::size
QUIET = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
GENERATE_HTML = YES
HTML_OUTPUT = html
GENERATE_LATEX = NO
GENERATE_MAN = YES
MAN_OUTPUT = man
MAN_EXTENSION = .3
MAN_LINKS = NO
GENERATE_XML = YES
XML_OUTPUT = xml
XML_PROGRAMLISTING = NO
SOURCE_BROWSER = NO
INLINE_SOURCES = NO
STRIP_CODE_COMMENTS = NO
JAVADOC_AUTOBRIEF = NO
HAVE_DOT = NO
CLASS_GRAPH = NO
EXAMPLE_PATH = tools/doxygen
