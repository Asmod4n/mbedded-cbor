 "probe": "// Probe: cost of the map comparisons of keys_equivalent and value_equal, old form (main) against canonical ids.\n#include <benchmark/benchmark.h>\n#include <cbor/cbor.hpp>\n#include <string>\n#include <cstdlib>\nusing namespace std::string_literals;\n\nstatic std::string shallow_maps(int n)\n{   // an array of n maps {\"a\": i, \"b\": [i, i], \"c\": \"x\"}; the filter compares each with a literal map\n    std::string s = \"\\x99\" + std::string(1, char(n >> 8)) + std::string(1, char(n & 0xff));\n    for (int i = 0; i < n; ++i) s += \"\\xa3\\x61\" \"a\\x01\\x61\" \"b\\x82\\x01\\x01\\x61\" \"c\\x61x\"s;\n    return s;\n}\nstatic std::string deep_map(int levels)\n{   // {\"k\": {\"k\": ... {\"k\": 1}}} twice in an array, compared with each other\n    std::string one;\n    for (int i = 0; i < levels; ++i) one += \"\\xa1\\x61k\"s;\n    one += \"\\x01\";\n    return \"\\x82\" + one + one;\n}\n#if defined(OP_SHALLOW)\nstatic std::string const doc = shallow_maps(4096);\nstatic char const *const path = \"$[?@ == {\\\"c\\\": \\\"x\\\", \\\"b\\\": [1, 1], \\\"a\\\": 1}]\";\n#elif defined(OP_DEEP)\nstatic std::string const doc = deep_map(64);\nstatic char const *const path = \"$[?@ == $[1]]\";\n#elif defined(OP_KEY)\nstatic std::string const doc = shallow_maps(4096);\nstatic char const *const path = \"$[*].c\";\n#endif\nstatic void op(benchmark::State &st)\n{\n    auto const l = cbor::lazy::take_ownership(std::string(doc));\n    auto const q = cbor::jsonpath::compile<cbor::nodelist>(path);\n    if (!l || !q) std::abort();\n    std::size_t n = 0;\n    for (auto _ : st) {\n        auto const r = l->at_path(*q);\n        if (!r) std::abort();\n        n = r->size();\n        benchmark::DoNotOptimize(n);\n    }\n    st.counters[\"nodes\"] = double(n);\n}\nBENCHMARK(op);\nBENCHMARK_MAIN();\n",
