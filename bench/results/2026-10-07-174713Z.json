  "typed": "#include <benchmark/benchmark.h>\n#include <algorithm>\n#include <bit>\n#include <cstdint>\n#include <cstring>\n#include <span>\n#include <vector>\n\nstatic constexpr std::size_t n = 60000;\nstatic std::vector<char> in(8 * n);\nstatic std::vector<double> out(n);\n\n[[gnu::noinline]] static void arm(std::span<char const> const b, std::span<double> const o)\n{\n#if defined(ARM_LE_COPY)\n    std::ranges::copy(std::as_bytes(b), std::as_writable_bytes(o).begin());\n#elif defined(ARM_LE_LOOP)\n    for (std::size_t i = 0; i < o.size(); ++i) {\n        std::uint64_t v;\n        std::memcpy(&v, b.subspan(8 * i, 8).data(), 8);\n        o[i] = std::bit_cast<double>(v);\n    }\n#elif defined(ARM_LE_LOOP_BYTES)\n    for (std::size_t i = 0; i < o.size(); ++i) {\n        std::uint64_t v;\n        std::memcpy(&v, b.subspan(8 * i, 8).data(), 8);\n        std::memcpy(&o[i], &v, 8);\n    }\n#elif defined(ARM_BE_LOOP)\n    for (std::size_t i = 0; i < o.size(); ++i) {\n        std::uint64_t v;\n        std::memcpy(&v, b.subspan(8 * i, 8).data(), 8);\n        o[i] = std::bit_cast<double>(std::byteswap(v));\n    }\n#elif defined(ARM_BE_LOOP_BYTES)\n    for (std::size_t i = 0; i < o.size(); ++i) {\n        std::uint64_t v;\n        std::memcpy(&v, b.subspan(8 * i, 8).data(), 8);\n        v = std::byteswap(v);\n        std::memcpy(&o[i], &v, 8);\n    }\n#elif defined(ARM_BE_REVERSE)\n    for (std::size_t i = 0; i < o.size(); ++i) {\n        auto const from = b.subspan(8 * i).first<8>();\n        auto const to = std::as_writable_bytes(o.subspan(i, 1));\n        std::ranges::reverse_copy(from, reinterpret_cast<char *>(to.data()));\n    }\n#else\n#error no arm\n#endif\n}\n\nstatic void run(benchmark::State &state)\n{\n    for (auto _ : state) {\n        if (in.size() != 8 * out.size()) [[unlikely]] std::abort();\n        arm(in, out);\n        benchmark::DoNotOptimize(out.data());\n        benchmark::ClobberMemory();\n    }\n}\n\nint main(int argc, char **argv)\n{\n    for (std::size_t i = 0; i < in.size(); ++i) in[i] = char(i * 131 + 7);\n    benchmark::RegisterBenchmark(\"op\", run);\n    benchmark::Initialize(&argc, argv);\n    benchmark::RunSpecifiedBenchmarks();\n    benchmark::Shutdown();\n}\n"
