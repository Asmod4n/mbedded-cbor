 "source_sha256": "553397d3af10bbb422128c4c7614b917be6a270e9744e8b666f52ec50fcaaa57",
 "source": "#include <cbor/cbor.hpp>\n\n#include <algorithm>\n#include <charconv>\n#include <chrono>\n#include <cstdint>\n#include <cstdio>\n#include <fstream>\n#include <iterator>\n#include <memory>\n#include <ranges>\n#include <string>\n#include <vector>\n\nstruct user {\n    std::string id_str, name, screen_name, location, description, url, created_at, profile_image_url_https, lang;\n    std::uint32_t followers_count, friends_count, statuses_count;\n};\n\nstruct status {\n    std::string created_at, id_str, text, source, lang;\n    std::uint32_t retweet_count, favorite_count;\n    user author;\n};\n\nstruct feed {\n    std::vector<status> statuses;\n};\n\nCBOR_DEFINE_TYPE_MEMBERS(user, cbor::tag{40201}, id_str, name, screen_name, location, description, url, created_at,\n                         profile_image_url_https, lang, followers_count, friends_count, statuses_count);\nCBOR_DEFINE_TYPE_MEMBERS(status, cbor::tag{40202}, created_at, id_str, text, source, lang, retweet_count, favorite_count, author);\nCBOR_DEFINE_TYPE_MEMBERS(feed, cbor::tag{40203}, statuses);\n\nstatic std::uint32_t number_of(std::string_view const s)\n{\n    std::uint32_t v = 0;\n    std::from_chars(s.data(), s.data() + s.size(), v);\n    return v;\n}\n\nusing root_t = cbor::schema<feed>::accessor<>;\n\n// Arm 1: every field from the root, with the index.\n[[gnu::noinline]] static std::size_t page_from_root(root_t &root, std::size_t const from, std::size_t const count)\n{\n    std::size_t sum = 0;\n    for (std::size_t i = from; i < from + count; ++i) {\n        sum += root.at_path<\"$.statuses[].text\">(i)->size();\n        sum += root.at_path<\"$.statuses[].created_at\">(i)->size();\n        sum += root.at_path<\"$.statuses[].author.name\">(i)->size();\n        sum += root.at_path<\"$.statuses[].author.screen_name\">(i)->size();\n        sum += root.at_path<\"$.statuses[].author.profile_image_url_https\">(i)->size();\n        sum += *root.at_path<\"$.statuses[].retweet_count\">(i);\n    }\n    return sum;\n}\n\n// Arm 2: one record accessor per element, fields relative to it.\n[[gnu::noinline]] static std::size_t page_from_record(root_t &root, std::size_t const from, std::size_t const count)\n{\n    std::size_t sum = 0;\n    for (std::size_t i = from; i < from + count; ++i) {\n        auto s = *root.at_path<\"$.statuses[]\">(i);\n        sum += s.at_path<\"@.text\">()->size();\n        sum += s.at_path<\"@.created_at\">()->size();\n        sum += s.at_path<\"@.author.name\">()->size();\n        sum += s.at_path<\"@.author.screen_name\">()->size();\n        sum += s.at_path<\"@.author.profile_image_url_https\">()->size();\n        sum += *s.at_path<\"@.retweet_count\">();\n    }\n    return sum;\n}\n\nint main(int, char **argv)\n{\n    std::ifstream in(argv[1], std::ios::binary);\n    std::string const text{std::istreambuf_iterator<char>(in), {}};\n    std::size_t const per_page = std::stoul(argv[2]);\n    feed f;\n    for (auto const r : text | std::views::split('\\x1e')) {\n        std::vector<std::string> p;\n        for (auto const x : r | std::views::split('\\x1f'))\n            p.emplace_back(std::string_view(x));\n        f.statuses.push_back(status{p[0], p[1], p[2], p[3], p[4], number_of(p[5]), number_of(p[6]),\n                                    user{p[7], p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15], number_of(p[16]),\n                                         number_of(p[17]), number_of(p[18])}});\n    }\n    auto const owner = std::make_shared<std::string const>(*cbor::schema<feed>::encode(f));\n    auto root = *cbor::schema<feed>::path(owner);\n    std::size_t const from = per_page == 100 ? 0 : 50;\n    constexpr int reps = 31;\n    constexpr int pages = 20000;\n    std::size_t check = 0;\n    std::printf(\"{\\\"arm\\\":%d,\\\"per_page\\\":%zu,\\\"ns_per_page\\\":[\", ARM, per_page);\n    for (int r = 0; r < reps; ++r) {\n        auto const t0 = std::chrono::steady_clock::now();\n        for (int k = 0; k < pages; ++k)\n            check += ARM == 1 ? page_from_root(root, from, per_page) : page_from_record(root, from, per_page);\n        auto const t1 = std::chrono::steady_clock::now();\n        std::printf(\"%s%.1f\", r ? \",\" : \"\", std::chrono::duration<double, std::nano>(t1 - t0).count() / pages);\n    }\n    std::printf(\"],\\\"check\\\":%zu}\\n\", check);\n}\n"
}