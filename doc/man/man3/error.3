.PP
A limit counts what a call reads or decodes.
An item that a call only skips does not count.
Every translation unit of one program uses the same values.
.SH ERRORS
.SS cbor::error
Not applicable: the type is the error.
.SS cbor::category
None.
.SS cbor::error_category
None.
.SS cbor::make_error_code
None.
.SS std::is_error_code_enum<cbor::error>
None.
.SS cbor::limits
A \f[CR]CBOR_NESTING_DEPTH_DEFAULT\f[R] above 512 does not compile.
.SH NOTES
.SS cbor::error
O(1).
An error is one \f[CR]int\f[R].
It does not allocate.
.SS cbor::category
O(1).
The object is a function\-local static: the first call constructs it.
No allocation.
.SS cbor::error_category
\f[CR]name\f[R] and \f[CR]default_error_condition\f[R] are O(1).
\f[CR]message\f[R] allocates the \f[CR]std::string\f[R].
.SS cbor::make_error_code
O(1).
No allocation.
.SS std::is_error_code_enum<cbor::error>
None at run time.
.SS cbor::limits
None at run time.
.SH EXAMPLES
.SS cbor::error
.IP
.EX
\f[I]// bytes: {\(dquser\(dq: {\(dqid\(dq: 42}}\f[R]
\f[B]auto\f[R] const age = cbor::at_path<\(dq$.user.age\(dq, std::int64_t>(bytes);
age.error();                                \f[I]// key_not_found\f[R]
std::error_code{age.error()}.message();     \f[I]// \(dqkey not found\(dq\f[R]
.EE
.SS cbor::category
.IP
.EX
std::error_code const e = cbor::error::syntax_error;
e.category() == cbor::category();   \f[I]// true\f[R]
cbor::category().name();            \f[I]// \(dqcbor\(dq\f[R]
.EE
.SS cbor::error_category
.IP
.EX
std::error_code{cbor::error::no_buffer_space} == std::errc::no_buffer_space;   \f[I]// true\f[R]
std::error_code{cbor::error::too_little_data} != std::errc::no_message;        \f[I]// true\f[R]
cbor::category().message(0);                                                   \f[I]// \(dqunknown cbor error\(dq\f[R]
.EE
.SS cbor::make_error_code
.IP
.EX
std::error_code const e = cbor::make_error_code(cbor::error::invalid_path);
e.message();                                   \f[I]// \(dqinvalid path\(dq\f[R]
e == std::error_code{cbor::error::invalid_path};   \f[I]// true\f[R]
.EE
.SS std::is_error_code_enum<cbor::error>
.IP
.EX
std::error_code const e = cbor::error::index_out_of_bounds;
e.message();                               \f[I]// \(dqindex outside of array bounds\(dq\f[R]
e == cbor::error::index_out_of_bounds;     \f[I]// true\f[R]
.EE
.SS cbor::limits
.IP
.EX
g++ \-DCBOR_NESTING_DEPTH_DEFAULT=16 \-DCBOR_STRING_LENGTH_DEFAULT=1024 ...
.EE
.IP
.EX
\f[I]// a build that sets no macro\f[R]
cbor::limits::nesting_depth;        \f[I]// 128\f[R]
cbor::limits::string_length;        \f[I]// SIZE_MAX\f[R]
cbor::limits::container_elements;   \f[I]// SIZE_MAX\f[R]
.EE
