.EE
.IP
.EX
\f[B]class\f[R] error_category : \f[B]public\f[R] std::error_category
{
\f[B]public\f[R]:
    char const *name() const \f[B]noexcept\f[R] \f[B]override\f[R];
    std::string message(int const condition) const \f[B]override\f[R];
