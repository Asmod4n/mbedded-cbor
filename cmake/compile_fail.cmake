string(REPLACE "@@" ";" arguments "${ARGUMENTS}")
execute_process(COMMAND ${COMPILER} ${arguments} ${SOURCE} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
if(COUNT EQUAL 0)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "${SOURCE} does not compile:\n${output}")
	endif()
	return()
endif()
if(result EQUAL 0)
	message(FATAL_ERROR "${SOURCE} compiles, and ${COUNT} errors were expected")
endif()
string(REGEX MATCHALL "${PATTERN}" found "${output}")
list(LENGTH found count)
if(NOT count EQUAL COUNT)
	message(FATAL_ERROR "${SOURCE} gives ${count} of ${COUNT} errors that match '${PATTERN}':\n${output}")
endif()
