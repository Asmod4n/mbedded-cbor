set(CBOR_COMPILE_JOB_MIB 1024)
set(CBOR_LINK_JOBS 2)
set(CBOR_RESERVE_DIVISOR 4)
set(CBOR_RESERVE_MIB_MIN 2048)
set(CBOR_BYTES_PER_MIB 1048576)
set(CBOR_KIB_PER_MIB 1024)
set(CBOR_CONCURRENT_BUILDS 1 CACHE STRING "Number of builds that run at the same time and share the memory and the processors of the host")
set(CBOR_RESERVED_PROCESSORS 0 CACHE STRING "Processors of the host that no build uses")
set(CBOR_MEMORY_MIB "" CACHE STRING "Memory of this build in MiB; empty for the memory of the host less its reserve, divided by CBOR_CONCURRENT_BUILDS")

if(CBOR_MEMORY_MIB STREQUAL "")
	set(total_mib 0)
	if(APPLE)
		execute_process(COMMAND sysctl -n hw.memsize OUTPUT_VARIABLE total_bytes OUTPUT_STRIP_TRAILING_WHITESPACE)
		math(EXPR total_mib "${total_bytes} / ${CBOR_BYTES_PER_MIB}")
	elseif(EXISTS /proc/meminfo)
		file(STRINGS /proc/meminfo total_line REGEX "^MemTotal:")
		string(REGEX MATCH "[0-9]+" total_kib "${total_line}")
		math(EXPR total_mib "${total_kib} / ${CBOR_KIB_PER_MIB}")
		if(EXISTS /sys/fs/cgroup/memory.max)
			file(READ /sys/fs/cgroup/memory.max cgroup_max)
			string(STRIP "${cgroup_max}" cgroup_max)
			if(cgroup_max MATCHES "^[0-9]+$")
				math(EXPR cgroup_mib "${cgroup_max} / ${CBOR_BYTES_PER_MIB}")
				if(cgroup_mib LESS total_mib)
					set(total_mib ${cgroup_mib})
				endif()
			endif()
		endif()
	endif()
	math(EXPR reserve_mib "${total_mib} / ${CBOR_RESERVE_DIVISOR}")
	if(reserve_mib LESS CBOR_RESERVE_MIB_MIN)
		set(reserve_mib ${CBOR_RESERVE_MIB_MIN})
	endif()
	math(EXPR memory_mib "(${total_mib} - ${reserve_mib}) / ${CBOR_CONCURRENT_BUILDS}")
else()
	set(memory_mib ${CBOR_MEMORY_MIB})
endif()

cmake_host_system_information(RESULT processors QUERY NUMBER_OF_LOGICAL_CORES)
math(EXPR compile_jobs "(${memory_mib} - ${CBOR_LINK_JOBS} * ${CBOR_COMPILE_JOB_MIB}) / ${CBOR_COMPILE_JOB_MIB}")
math(EXPR parallel_jobs "(${processors} - ${CBOR_RESERVED_PROCESSORS}) / ${CBOR_CONCURRENT_BUILDS}")
if(parallel_jobs LESS 1)
	set(parallel_jobs 1)
endif()
if(compile_jobs GREATER parallel_jobs)
	set(compile_jobs ${parallel_jobs})
endif()
if(compile_jobs LESS 1)
	set(compile_jobs 1)
endif()
set(link_jobs ${CBOR_LINK_JOBS})
if(link_jobs GREATER parallel_jobs)
	set(link_jobs ${parallel_jobs})
endif()
set(CBOR_PARALLEL_JOBS ${parallel_jobs} CACHE INTERNAL "Jobs of one build in all, the -j that caps both pools together")
set(CBOR_PARALLEL_COMPILE_JOBS ${compile_jobs} CACHE INTERNAL "Jobs of the pool compile_job_pool")

set_property(GLOBAL APPEND PROPERTY JOB_POOLS compile_job_pool=${compile_jobs} link_job_pool=${link_jobs})
set(CMAKE_JOB_POOL_COMPILE compile_job_pool)
set(CMAKE_JOB_POOL_LINK link_job_pool)
if(NOT CMAKE_GENERATOR MATCHES "Ninja")
	message(STATUS "mbedded-cbor: the generator ${CMAKE_GENERATOR} has no job pools, so the build does not limit its memory")
endif()
message(STATUS "mbedded-cbor: ${memory_mib} MiB for this build, ${compile_jobs} compile jobs, ${link_jobs} link jobs, ${parallel_jobs} jobs in all")
