set(CMAKE_SYSTEM_NAME WASI)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(CMAKE_CXX_COMPILER clang++-23)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasip1)
set(CBOR_WASI_SYSROOT /opt/wasi-sysroot-34.0 CACHE PATH "Sysroot of wasi-sdk with the C++ standard library built with exceptions")
set(CMAKE_SYSROOT ${CBOR_WASI_SYSROOT})
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CBOR_WASI_SYSROOT)
set(CMAKE_CXX_FLAGS_INIT "-fwasm-exceptions -mllvm -wasm-use-legacy-eh=false")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fwasm-exceptions -lunwind")
set(CMAKE_CROSSCOMPILING_EMULATOR node ${CMAKE_CURRENT_LIST_DIR}/../test/wasi/run.mjs)
set(CMAKE_FIND_ROOT_PATH ${CBOR_WASI_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
