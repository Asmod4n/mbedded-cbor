set(arguments)
if(NOT PATTERN STREQUAL "")
	set(arguments "-tc=*${PATTERN}*")
endif()
file(REMOVE ${STAMP})
execute_process(COMMAND ${PROGRAM} ${arguments} RESULT_VARIABLE status OUTPUT_FILE ${LOG} ERROR_FILE ${LOG})
if(NOT status EQUAL 0)
	file(READ ${LOG} output)
	message(FATAL_ERROR "${PROGRAM} ends with ${status}:\n${output}")
endif()
file(TOUCH ${STAMP})
