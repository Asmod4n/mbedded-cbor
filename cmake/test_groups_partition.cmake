function(cbor_test_names program result)
	execute_process(COMMAND ${EMULATOR} ${program} -ltc -nc RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
	if(NOT status EQUAL 0)
		message(FATAL_ERROR "${program} -ltc fails:\n${output}${errors}")
	endif()
	string(REPLACE ";" "\;" output "${output}")
	string(REPLACE "\n" ";" lines "${output}")
	list(FILTER lines EXCLUDE REGEX "^\\[doctest\\] |^=+$|^$")
	set(${result} "${lines}" PARENT_SCOPE)
endfunction()

file(STRINGS ${PROGRAMS} programs)
set(parts)
foreach(program IN LISTS programs)
	cbor_test_names(${program} names)
	list(APPEND parts ${names})
endforeach()
list(SORT parts)
cbor_test_names(${FULL} full)
list(SORT full)
list(LENGTH parts parts_count)
list(LENGTH full full_count)
if(parts_count EQUAL 0 OR NOT parts STREQUAL full)
	set(only_parts ${parts})
	foreach(name IN LISTS full)
		list(FIND only_parts "${name}" at)
		if(at GREATER_EQUAL 0)
			list(REMOVE_AT only_parts ${at})
		endif()
	endforeach()
	set(only_full ${full})
	foreach(name IN LISTS parts)
		list(FIND only_full "${name}" at)
		if(at GREATER_EQUAL 0)
			list(REMOVE_AT only_full ${at})
		endif()
	endforeach()
	message(FATAL_ERROR "The programs of the test files hold ${parts_count} test cases, mbedded-cbor-test ${full_count}.\nOnly in the programs of the test files: ${only_parts}\nOnly in mbedded-cbor-test: ${only_full}")
endif()
message(STATUS "The programs of the test files hold the ${parts_count} test cases of mbedded-cbor-test, each as often as there.")
