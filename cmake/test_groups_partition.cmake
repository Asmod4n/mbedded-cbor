function(cbor_test_names program filter result)
	execute_process(COMMAND ${program} -ltc -nc ${filter} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output)
	if(NOT status EQUAL 0)
		message(FATAL_ERROR "${program} -ltc fails:\n${output}")
	endif()
	string(REPLACE ";" "\\;" output "${output}")
	string(REPLACE "\n" ";" lines "${output}")
	list(FILTER lines EXCLUDE REGEX "^\\[doctest\\] |^=+$|^$")
	list(SORT lines)
	set(${result} "${lines}" PARENT_SCOPE)
endfunction()

cbor_test_names(${GROUP} "" group)
cbor_test_names(${FULL} "-sf=*/schema.cpp,*/schema_depth.cpp" full)
list(LENGTH group group_count)
list(LENGTH full full_count)
if(group_count EQUAL 0 OR NOT group STREQUAL full)
	set(only_group ${group})
	list(REMOVE_ITEM only_group ${full})
	set(only_full ${full})
	list(REMOVE_ITEM only_full ${group})
	message(FATAL_ERROR "The parts hold ${group_count} test cases, the whole file ${full_count}.\nOnly in the parts: ${only_group}\nOnly in the whole file: ${only_full}")
endif()
message(STATUS "The parts hold the ${group_count} test cases of the whole file, each once.")
