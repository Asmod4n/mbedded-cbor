.SH EXAMPLES
.SS cbor::error
.IP
.EX
\f[I]// bytes: {\(dquser\(dq: {\(dqid\(dq: 42}}\f[R]
\f[B]auto\f[R] const age = cbor::at_path<\(dq$.user.age\(dq, std::int64_t>(bytes);
\f[B]auto\f[R] const e = age.error();                              \f[I]// key_not_found\f[R]
\f[B]auto\f[R] const text = std::error_code{e}.message();          \f[I]// \(dqkey not found\(dq\f[R]
.EE
.SS cbor::category
.IP
.EX
std::error_code const e = cbor::error::syntax_error;
bool const same = e.category() == cbor::category();     \f[I]// true\f[R]
std::string_view const name = cbor::category().name();  \f[I]// \(dqcbor\(dq\f[R]
.EE
.SS cbor::error_category
.IP
.EX
bool const space = std::error_code{cbor::error::no_buffer_space} == std::errc::no_buffer_space;  \f[I]// true\f[R]
bool const other = std::error_code{cbor::error::too_little_data} == std::errc::no_message;       \f[I]// false\f[R]
std::string const unknown = cbor::category().message(0);                                         \f[I]// \(dqunknown cbor error\(dq\f[R]
.EE
.SS cbor::make_error_code
.IP
.EX
std::error_code const e = cbor::make_error_code(cbor::error::invalid_path);
std::string const text = e.message();                               \f[I]// \(dqinvalid path\(dq\f[R]
bool const same = e == std::error_code{cbor::error::invalid_path};  \f[I]// true\f[R]
.EE
.SS std::is_error_code_enum<cbor::error>
.IP
.EX
std::error_code const e = cbor::error::index_out_of_bounds;
std::string const text = e.message();                     \f[I]// \(dqindex outside of array bounds\(dq\f[R]
bool const same = e == cbor::error::index_out_of_bounds;  \f[I]// true\f[R]
.EE
.SS cbor::limits
.IP
.EX
\f[I]// a build that sets no macro\f[R]
std::size_t const strings = cbor::limits::string_length;          \f[I]// SIZE_MAX\f[R]
std::size_t const containers = cbor::limits::container_elements;  \f[I]// SIZE_MAX\f[R]
.EE
