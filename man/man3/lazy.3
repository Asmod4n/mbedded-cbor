.SH EXAMPLES
.SS cbor::lazy
.IP
.EX
\f[I]// bytes: a std::string with [1, 2]\f[R]
\f[B]auto\f[R] const doc = cbor::lazy::take_ownership(std::move(bytes));
cbor::lazy const copy = *doc;
\f[B]auto\f[R] const second = copy.at(1)\->get<int>();  \f[I]// 2\f[R]
\f[I]// cbor::lazy{}.size() throws std::logic_error\f[R]
.EE
.SS cbor::lazy::take_ownership
.IP
.EX
\f[I]// bytes: a std::string with {\(dqid\(dq: 42}\f[R]
\f[B]auto\f[R] const doc = cbor::lazy::take_ownership(std::move(bytes));
\f[B]if\f[R] (doc)
    id = doc\->at(\(dqid\(dq)\->get<std::int64_t>().value_or(0);  \f[I]// 42\f[R]
.EE
.SS cbor::lazy::view
.IP
.EX
\f[I]// owner: a std::shared_ptr<std::string const> with {\(dqid\(dq: 42}\f[R]
\f[B]auto\f[R] const doc = cbor::lazy::view(owner);
\f[B]auto\f[R] const id = doc\->at(\(dqid\(dq)\->get<std::int64_t>();  \f[I]// 42\f[R]
.EE
.SS cbor::lazy::at
.IP
.EX
\f[I]// bytes: a std::string with {\(dqcars\(dq: [{\(dqhp\(dq: 5}, {\(dqhp\(dq: 7}], 7: \(dqseven\(dq}\f[R]
\f[B]auto\f[R] const doc = cbor::lazy::take_ownership(std::move(bytes));
\f[B]auto\f[R] const hp = doc\->at(\(dqcars\(dq)\->at(1)\->at(\(dqhp\(dq)\->get<int>();  \f[I]// 7\f[R]
\f[B]auto\f[R] const seven = doc\->at(cbor::key{7})\->get<std::string_view>();  \f[I]// a ref to \(dqseven\(dq\f[R]
\f[B]auto\f[R] const bus = doc\->at(\(dqbus\(dq);                                   \f[I]// key_not_found\f[R]
\f[B]auto\f[R] const first = doc\->at(0);                                     \f[I]// not_indexable\f[R]
.EE
.SS cbor::lazy::operator[]
.IP
.EX
