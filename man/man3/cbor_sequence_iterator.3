.TH "cbor::sequence::iterator" 3 "Version 0.9.0" "mbedded-cbor" \" -*- nroff -*-
.ad l
.nh
.SH NAME
cbor::sequence::iterator \- Reads the items of a sequence one after the other\&.  

.SH SYNOPSIS
.br
.PP
.PP
\fR#include <cbor/sequence\&.hpp>\fP
.SS "Public Types"

.in +1c
.ti -1c
.RI "using \fBvalue_type\fP = std::expected<std::string_view, \fBerror\fP>"
.br
.RI "The bytes of one item, or the error of that item\&. "
.ti -1c
.RI "using \fBdifference_type\fP = std::ptrdiff_t"
.br
.RI "The type of the distance between two iterators\&. "
.in -1c
.SS "Public Member Functions"

.in +1c
.ti -1c
.RI "\fBiterator\fP ()=default"
.br
.RI "Makes an iterator that is at the end\&. "
.ti -1c
.RI "std::string_view \fBencoded\fP () const"
.br
.RI "Gives the bytes from the current item to the end of the sequence\&. "
.ti -1c
.RI "\fBvalue_type\fP \fBoperator*\fP () const"
.br
.RI "Gives the current item\&. "
.ti -1c
.RI "iterator & \fBoperator++\fP ()"
.br
.RI "Goes to the next item, or to the end after an item with an error\&. "
.ti -1c
.RI "void \fBoperator++\fP (int)"
.br
.RI "Goes to the next item, as the prefix \fR++\fP does\&. "
.ti -1c
.RI "bool \fBoperator==\fP (std::default_sentinel_t) const"
.br
.RI "Tells if the iterator is at the end\&. "
.in -1c
.SH "DESCRIPTION"
.PP 
Reads the items of a sequence one after the other\&. 
