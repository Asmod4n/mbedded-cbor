.SH "DESCRIPTION"
.PP 

.SS "template<std::size_t N>
.br
struct cbor::fixed_string< N >"The type of a path at compile time\&. 

A string literal converts to it, so \fR\fBat_path\fP<"$\&.id", int>\fP names no \fR\fBfixed_string\fP\fP\&. A program names it in its own template that passes a path on\&. \fRvalue\fP holds the characters and the closing zero\&. \fRview()\fP gives the characters without the zero\&. The constructor is \fRconsteval\fP: a \fR\fBfixed_string\fP\fP exists only at compile time\&. It checks no grammar; \fBcbor::is_valid_path_v\fP does\&. A text that is not a constant expression does not compile\&.

.PP
.PP
.nf
cbor::at_path<"$\&.id", std::int64_t>(bytes) → std::expected<std::int64_t, error>
Path\&.view()                                → std::string_view
.fi
.PP
 
.PP
.nf
message: {"id": 42}
call: cbor::at_path<"$\&.id", std::int64_t>(bytes)\&.value_or(0)
result: 42
call: cbor::at_path<"$\&.age", std::int64_t>(bytes)\&.value_or(0)
result: 0

.fi
.PP

.PP
.PP
.nf
template <cbor::fixed_string Path>
std::int64_t read_or_zero(std::string_view const bytes)
{
    return cbor::at_path<Path, std::int64_t>(bytes)\&.value_or(0);
}
.fi
.PP
 
.PP
.nf
    // bytes: {"id": 42}
    auto const id = read_or_zero<"$\&.id">(bytes);    // 42
    auto const age = read_or_zero<"$\&.age">(bytes);  // 0
.fi
.PP
 
.PP
