.fi
.PP

.PP
.PP
.nf
    // point: a struct whose description has the tag 1802
    auto const bytes = cbor::schema<point>::encode(point{1, 2});
    std::size_t const root = bytes\->size() \- cbor::schema<point>::fixed_size();  // the root record starts with d9 07 0a
.fi
.PP
 
