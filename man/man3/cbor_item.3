.TH "cbor::item" 3 "Version 0.9.0" "mbedded-cbor" \" -*- nroff -*-
.ad l
.nh
.SH NAME
cbor::item \- One node of a tree from \fBcbor::decode()\fP or \fR\fBlazy::to_item\fP\fP\&.  

.SH SYNOPSIS
.br
.PP
.PP
\fR#include <cbor/item\&.hpp>\fP
.SS "Public Member Functions"

.in +1c
.ti -1c
.RI "constexpr cbor::type \fBtype\fP () const"
.br
.RI "Gives the kind of the node\&. "
.ti -1c
.RI "std::expected< std::string, \fBerror\fP > \fBto_edn\fP () const"
.br
.RI "Gives the text of the item in the extended diagnostic notation (EDN)\&. "
.ti -1c
.RI "template<class T>"
.br
requires ((scalar_result<T> ) || view_result<T> || std::same_as<T, std::span<item const>> || detail::is_pairs_of_items<T, item,
.br
 rfc8949::data_items_per_pair> || std::same_as<T, std::pair<std::uint64_t, item const *>>)
.br
std::expected< T, \fBerror\fP > \fBget\fP () const
.br
.RI "Gives the value of the node as \fRT\fP, as \fBcbor::lazy::get()\fP reads it\&. "
.in -1c
.SS "Public Attributes"

.in +1c
.ti -1c
.RI "std::uint8_t const \fBadditional_information\fP"
.br
.in -1c
.SH "DESCRIPTION"
.PP 
One node of a tree from \fBcbor::decode()\fP or \fR\fBlazy::to_item\fP\fP\&. 

\fBcbor::item::type()\fP gives the kind of the node\&. \fRadditional_information\fP gives the low 5 bits of the initial byte (RFC 8949 3)\&. \fBcbor::item::get()\fP and cbor::item::visit() give the value\&. The constructor is private: only a decode makes an item\&. An item owns no memory and has no destructor to run\&. The tree owns every node and every string\&. An item gives no error\&. \fRadditional_information\fP is a data member\&.

.PP
.PP
.nf
message: [1, {"a": 2}]
call: auto const tree = cbor::decode(bytes)
result: owning item of [1, {"a": 2}]
call: (*tree)\->type()
result: cbor::type::array
call: (*tree)\->additional_information
result: 2
call: (*tree)\->get<std::span<cbor::item const>>()\->size()
result: 2
.fi
.PP

.PP
.PP
.nf
    // bytes: a std::string with [1, {"a": 2}]
    auto const tree = cbor::decode(bytes);
    auto const kind = (*tree)\->type();                              // cbor::type::array
    auto const count = (*tree)\->get<std::span<cbor::item const>>()\->size();  // 2
.fi
.PP
 
.PP
\fBSee also\fP
.RS 4
\fBcbor::item::get()\fP 

.PP
\fBcbor::decode()\fP 

.PP
\fBcbor::encode()\fP 
.RE
.PP

