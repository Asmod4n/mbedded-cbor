.TH "cbor::structs" "3" "2026-11-08" "mbedded\-cbor 0.9.0" "mbedded\-cbor"
.SH NAME
cbor::structs, cbor::structs<T>::encode, cbor::structs<T>::decode, cbor::describe_members<T>, cbor::member<P>, CBOR_MEMBER, CBOR_DEFINE_TYPE_MEMBERS, cbor::structs<T> \- any CBOR into a C++ struct and back
.SH SYNOPSIS
.IP
.EX
#include \f[B]<cbor/cbor.hpp>\f[R]
.EE
