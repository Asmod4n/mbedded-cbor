.PP
\f[CR]decode\f[R] gives \f[CR]incorrect_type\f[R] for another item: a
\f[CR]std::vector<int>\f[R] takes a typed array, not an array.
An enum with no fixed underlying type, a \f[CR]long double\f[R] and a
struct under \f[CR]tagged_item\f[R] do not compile.
.SH ERRORS
.SS cbor::structs<T>::encode
.IP \(bu 2
\f[CR]value_too_large\f[R]: the size of the bytes does not fit in
\f[CR]std::size_t\f[R]
.IP \(bu 2
\f[CR]no_buffer_space\f[R]: a \f[CR]std::span<char>\f[R] that is too
small for the bytes, or the writer gives this error
.IP \(bu 2
\f[CR]not_enough_memory\f[R], \f[CR]io_error\f[R]: the writer gives this
error
.IP \(bu 2
\f[CR]std::logic_error\f[R]: a \f[CR]std::chrono::year_month_day\f[R]
that is no valid date
.IP \(bu 2
\f[CR]std::bad_alloc\f[R]: a refused allocation of the result
.SS cbor::structs<T>::decode
.IP \(bu 2
\f[CR]incorrect_type\f[R]: an item of another type, or a missing or
other tag
.IP \(bu 2
\f[CR]number_out_of_range\f[R]: a number that the type cannot hold
.IP \(bu 2
\f[CR]key_not_found\f[R]: no key for a member that is not
\f[CR]std::optional\f[R]
.IP \(bu 2
\f[CR]duplicate_key\f[R]: a key that comes twice
.IP \(bu 2
\f[CR]too_little_data\f[R]: the input ends inside the item
.IP \(bu 2
\f[CR]syntax_error\f[R]: a head is not well\-formed
.IP \(bu 2
\f[CR]indefinite_length\f[R]: a head uses indefinite length
.IP \(bu 2
\f[CR]nesting_depth_exceeded\f[R]: the item is deeper than the stack of
the thread holds
.IP \(bu 2
\f[CR]inadmissible_type_for_tag_content\f[R]: a tag has content that its
definition does not allow
.IP \(bu 2
\f[CR]sharedref_index_not_marked\f[R],
\f[CR]sharedref_index_out_of_range\f[R],
\f[CR]sharedref_not_complete\f[R]: a tag 29 that names no shared value
that the decode holds
.IP \(bu 2
\f[CR]string_length_exceeded\f[R]: a string is longer than
\f[CR]limits::string_length\f[R]
.IP \(bu 2
\f[CR]container_elements_exceeded\f[R]: the count of an array or a map
is greater than \f[CR]limits::container_elements\f[R]
.IP \(bu 2
\f[CR]not_enough_memory\f[R]: a refused allocation
.IP \(bu 2
\f[CR]std::logic_error\f[R]: \f[CR]encoded\f[R] is null
.IP \(bu 2
\f[CR]std::logic_error\f[R]: \f[CR]owner\f[R] is empty
.SH EXAMPLES
.SS cbor::structs<T>::encode
.IP
.EX
\f[I]// person: struct { std::string name; int age; }\f[R]
\f[B]auto\f[R] const bytes = cbor::structs<person>::encode(person{\(dqann\(dq, 30});  \f[I]// {\(dqage\(dq: 30, \(dqname\(dq: \(dqann\(dq}\f[R]
.EE
.SS cbor::structs<T>::decode
.IP
.EX
\f[I]// bytes: a std::string with {\(dqname\(dq: \(dqann\(dq, \(dqage\(dq: 30}\f[R]
\f[B]auto\f[R] const p = cbor::structs<person>::decode(std::move(bytes));
\f[B]if\f[R] (p)
    age = (*p)\->age;  \f[I]// 30\f[R]
.EE
.SS cbor::describe_members<T>
.IP
.EX
\f[B]template\f[R] <>
\f[B]struct\f[R] cbor::describe_members<reference_structs::header> {
    static \f[B]constexpr\f[R] std::optional<cbor::tag> tag = cbor::tag{160060};
    static \f[B]constexpr\f[R] std::tuple members{
        cbor::member{\(dqcontent\-type\(dq, &reference_structs::header::content_type},
    };
};
.EE
.IP
.EX
\f[B]auto\f[R] const bytes = cbor::structs<header>::encode(header{\(dqtext/plain\(dq});  \f[I]// 160060({\(dqcontent\-type\(dq: \(dqtext/plain\(dq})\f[R]
.EE
.IP
.EX
CBOR_DEFINE_TYPE(reference_structs::trailer, cbor::tag{160061},
                 cbor::member{\(dqchecksum\(dq, &reference_structs::trailer::checksum});
.EE
.IP
.EX
\f[I]// trailer: struct { std::uint8_t checksum; }\f[R]
\f[B]auto\f[R] const bytes = cbor::structs<trailer>::encode(trailer{7});  \f[I]// 160061({\(dqchecksum\(dq: 7})\f[R]
.EE
.SS cbor::member<P>
.IP
.EX
\f[B]template\f[R] <>
\f[B]struct\f[R] cbor::describe_members<reference_structs::senml> {
    static \f[B]constexpr\f[R] std::optional<cbor::tag> tag = cbor::untagged;
    static \f[B]constexpr\f[R] std::tuple members{
        cbor::member{0, &reference_structs::senml::n},
        cbor::member{2, &reference_structs::senml::v},
    };
};
.EE
.IP
.EX
\f[B]auto\f[R] const bytes = cbor::structs<senml>::encode(senml{\(dqt\(dq, 1.5});  \f[I]// {0: \(dqt\(dq, 2: 1.5}\f[R]
.EE
.SS CBOR_MEMBER
.IP
.EX
\f[B]template\f[R] <>
\f[B]struct\f[R] cbor::describe_members<reference_structs::account> {
    static \f[B]constexpr\f[R] std::optional<cbor::tag> tag = cbor::untagged;
    static \f[B]constexpr\f[R] std::tuple members{
        CBOR_MEMBER(reference_structs::account, user),
        CBOR_MEMBER(reference_structs::account, level),
    };
};
.EE
.IP
.EX
\f[B]auto\f[R] const bytes = cbor::structs<account>::encode(account{\(dqann\(dq, 2});  \f[I]// {\(dquser\(dq: \(dqann\(dq, \(dqlevel\(dq: 2}\f[R]
.EE
.SS CBOR_DEFINE_TYPE_MEMBERS
.IP
.EX
CBOR_DEFINE_TYPE_MEMBERS(reference_structs::device, cbor::untagged, name, port);
.EE
.IP
.EX
\f[B]auto\f[R] const bytes = cbor::structs<device>::encode(device{\(dqlamp\(dq, 3});  \f[I]// {\(dqname\(dq: \(dqlamp\(dq, \(dqport\(dq: 3}\f[R]
.EE
.SS cbor::structs<T>
.IP
.EX
\f[I]// reading: struct { std::uint8_t id; std::optional<std::uint8_t> unit; }\f[R]
\f[B]auto\f[R] const one = cbor::structs<reading>::encode(reading{4, std::nullopt});    \f[I]// {\(dqid\(dq: 4}\f[R]
\f[B]auto\f[R] const set = cbor::structs<std::set<std::uint8_t>>::encode({3, 1});        \f[I]// 258([1, 3])\f[R]
.EE
