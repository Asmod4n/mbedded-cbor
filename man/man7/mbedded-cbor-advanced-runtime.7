\f[I]// [1, {\(dqa\(dq: 2}]\f[R]
\f[B]auto\f[R] const tree = cbor::lazy::view(owner)\->clone();
(*tree)\->type;                                   \f[I]// cbor::type::array\f[R]
(*tree)\->get<cbor::type::array>()\->size();       \f[I]// 2\f[R]
