.TE
.PP
A library that is not in the image has no code in this document.
fxamacker/cbor (Go), ciborium (Rust), cbor2 (Python) and CBOR::XS (Perl)
are not C++, and this document does not compare them.
.PP
nlohmann/json reads CBOR with \f[CR]from_cbor\f[R] into a
\f[CR]nlohmann::json\f[R] tree.
libcbor reads CBOR into a tree of \f[CR]cbor_item_t\f[R].
FlatBuffers and Cap\(aqn Proto are not CBOR.
They read their own wire format, and they need a schema file and a code
generator.
The schema files of this document:
.IP
.EX
namespace fb;
table User { id:int; }
table Root { user:User; }
table Person { name:string; age:int; }
table Ints { values:[int]; }
table Names { values:[string]; }
table Doubles { values:[double]; }
.EE
.IP
.EX
\(at0xd1c2b3a4f5e6d7c8;
struct User { id \(at0 :Int32; }
struct Root { user \(at0 :User; }
struct Person { name \(at0 :Text; age \(at1 :Int32; }
struct Ints { values \(at0 :List(Int32); }
struct Doubles { values \(at0 :List(Float64); }
.EE
.SS 2. Read one field by path
The input is {\(dquser\(dq: {\(dqid\(dq: 42}}.
The result is 42.
.SS C++ in memory
.IP
.EX
std::map<std::string, std::map<std::string, int>> const doc{{\(dquser\(dq, {{\(dqid\(dq, 42}}}};
int const id = doc.at(\(dquser\(dq).at(\(dqid\(dq);
.EE
.SS mbedded\-cbor
at_path reads the heads on the way to the field and decodes nothing
else.
The result is a std::expected.
.IP
.EX
\f[I]// bytes: {\(dquser\(dq: {\(dqid\(dq: 42}}\f[R]
std::expected<std::int64_t, cbor::error> const id = cbor::at_path<\(dq$.user.id\(dq, std::int64_t>(bytes);
.EE
.SS nlohmann/json
from_cbor decodes the whole input into a tree.
at() throws std::out_of_range for a key that is not there.
.IP
.EX
nlohmann::json const doc = nlohmann::json::from_cbor(bytes);
int const id = doc.at(\(dquser\(dq).at(\(dqid\(dq).get<int>();
\f[I]// alternative: doc.at(nlohmann::json::json_pointer(\(dq/user/id\(dq))\f[R]
.EE
.SS libcbor
libcbor has no lookup of a key.
The caller writes it.
.IP
.EX
static cbor_item_t *map_get(cbor_item_t *map, std::string_view key)
{
    cbor_pair const *pairs = cbor_map_handle(map);
    \f[B]for\f[R] (std::size_t i = 0; i < cbor_map_size(map); i++) {
        cbor_item_t *k = pairs[i].key;
        \f[B]if\f[R] (cbor_isa_string(k) && cbor_string_length(k) == key.size() &&
            std::memcmp(cbor_string_handle(k), key.data(), key.size()) == 0)
            \f[B]return\f[R] pairs[i].value;
    }
    \f[B]return\f[R] \f[B]nullptr\f[R];
}

cbor_load_result result;
cbor_item_t *doc = cbor_load(bytes, \f[B]sizeof\f[R] bytes, &result);
cbor_item_t *user = map_get(doc, \(dquser\(dq);
cbor_item_t *id = user ? map_get(user, \(dqid\(dq) : \f[B]nullptr\f[R];
std::uint64_t const value = id ? cbor_get_int(id) : 0;
cbor_decref(&doc);
.EE
.SS FlatBuffers
.IP
.EX
int const id = flatbuffers::GetRoot<fb::Root>(buf)\->user()\->id();
.EE
.SS Cap\(aqn Proto
.IP
.EX
capnp::FlatArrayMessageReader reader(words);
int const id = reader.getRoot<Root>().getUser().getId();
.EE
.SS 3. Read and write a struct
The struct holds a name and an age.
The code writes it and reads it back.
.SS C++ in memory
.IP
.EX
\f[B]struct\f[R] person {
    std::string name;
    int age;
};
person const p{\(dqann\(dq, 30};
person const copy = p;
.EE
.SS mbedded\-cbor
structs reads the members of an aggregate by C++26 reflection on g++ 16,
and through Boost.PFR on every other compiler.
The struct needs no macro and no tag.
.IP
.EX
\f[B]struct\f[R] person {
    std::string name;
    int age;
};

\f[B]auto\f[R] bytes = cbor::structs<person>::encode(person{\(dqann\(dq, 30});
\f[B]auto\f[R] const back = cbor::structs<person>::decode(std::move(*bytes));
\f[I]// (*back)\->name is \(dqann\(dq, (*back)\->age is 30\f[R]
.EE
.SS nlohmann/json
A macro names each member once more.
.IP
.EX
\f[B]struct\f[R] person {
    std::string name;
    int age;
};
NLOHMANN_DEFINE_TYPE_NON_INTRUSIVE(person, name, age)

std::vector<std::uint8_t> const bytes = nlohmann::json::to_cbor(person{\(dqann\(dq, 30});
person const back = nlohmann::json::from_cbor(bytes).get<person>();
.EE
.SS libcbor
libcbor is a C library.
Its headers in /usr/include/cbor declare functions on
\f[CR]cbor_item_t\f[R] and none on a type of the caller, so it has no
mapping of a struct.
This document shows no code for it.
.SS FlatBuffers
The struct is the table Person of the schema file.
flatc writes its C++ type.
.IP
.EX
flatbuffers::FlatBufferBuilder b;
b.Finish(fb::CreatePerson(b, b.CreateString(\(dqann\(dq), 30));
\f[B]auto\f[R] const *back = flatbuffers::GetRoot<fb::Person>(b.GetBufferPointer());
std::string const name = back\->name()\->str();
int const age = back\->age();
.EE
.SS Cap\(aqn Proto
The struct is Person of the schema file.
capnp compile writes its C++ type.
.IP
.EX
capnp::MallocMessageBuilder m;
\f[B]auto\f[R] p = m.initRoot<Person>();
p.setName(\(dqann\(dq);
p.setAge(30);
\f[B]auto\f[R] const words = capnp::messageToFlatArray(m);
capnp::FlatArrayMessageReader reader(words);
\f[B]auto\f[R] const back = reader.getRoot<Person>();
std::string const name = back.getName().cStr();
int const age = back.getAge();
.EE
.SS 4. Iterate an array
The input is [1, 2, 3].
The result is the sum 6.
.SS C++ in memory
.IP
.EX
std::vector<int> const v{1, 2, 3};
int sum = 0;
\f[B]for\f[R] (int const x : v)
    sum += x;
.EE
.SS mbedded\-cbor
elements() gives a forward range.
Each element is a std::expected<cbor::lazy, cbor::error>.
.IP
.EX
\f[B]auto\f[R] const doc = cbor::lazy::take_ownership(std::move(bytes)); \f[I]// [1, 2, 3]\f[R]
std::int64_t sum = 0;
\f[B]for\f[R] (\f[B]auto\f[R] const e : *doc\->elements())
    sum += e\->get<std::int64_t>().value_or(0);
.EE
.SS nlohmann/json
.IP
.EX
int sum = 0;
\f[B]for\f[R] (\f[B]auto\f[R] const &x : nlohmann::json::from_cbor(bytes))
    sum += x.get<int>();
.EE
.SS libcbor
.IP
.EX
cbor_load_result result;
cbor_item_t *doc = cbor_load(bytes, \f[B]sizeof\f[R] bytes, &result);
std::uint64_t sum = 0;
\f[B]for\f[R] (std::size_t i = 0; i < cbor_array_size(doc); i++)
    sum += cbor_get_int(cbor_array_handle(doc)[i]);
cbor_decref(&doc);
.EE
.SS FlatBuffers
.IP
.EX
int sum = 0;
\f[B]for\f[R] (int const x : *flatbuffers::GetRoot<fb::Ints>(buf)\->values())
    sum += x;
.EE
.SS Cap\(aqn Proto
.IP
.EX
capnp::FlatArrayMessageReader reader(words);
int sum = 0;
\f[B]for\f[R] (int const x : reader.getRoot<Ints>().getValues())
    sum += x;
.EE
.SS 5. Shared values
A shared value is one value that two places of a document hold.
CBOR writes it with tag 28 (mark the value) and tag 29 (a reference to
the n\-th marked value).
The input is [28(\(dqx\(dq), 29(0)], and both elements are \(dqx\(dq.
.SS C++ in memory
.IP
.EX
\f[B]auto\f[R] const x = std::make_shared<std::string const>(\(dqx\(dq);
std::vector<std::shared_ptr<std::string const>> const v{x, x};
bool const same = v[0] == v[1];
.EE
.SS mbedded\-cbor
Tags 28 and 29 are plain tags in a lazy, in a path and in a tree decode.
Only \f[CR]cbor::structs\f[R] decode resolves them.
No writer of the library adds them by itself.
\f[CR]encode\f[R] of an item writes a tag 28 or 29 that the item holds,
and a program writes them with \f[CR]encoder::tag\f[R] (runtime.md).
.IP
.EX
\f[I]// owner: a std::shared_ptr<std::string const> with [28(\(dqx\(dq), 29(0)]\f[R]
\f[B]auto\f[R] const second = cbor::lazy::view(owner)\->at(1);
\f[I]// second\->type() is cbor::type::tag, and second\->get<std::uint64_t>() is 0\f[R]

\f[B]auto\f[R] const v = cbor::structs<std::vector<std::string>>::decode(owner);
\f[I]// v.error() is cbor::error::incorrect_type\f[R]
.EE
.SS nlohmann/json
nlohmann/json has no shared values.
from_cbor with cbor_tag_handler_t::ignore drops the tags, and 29(0)
becomes the number 0.
The default handler gives a parse_error for a tag.
.IP
.EX
std::vector<std::uint8_t> const bytes{0x82, 0xd8, 0x1c, 0x61, \(aqx\(aq, 0xd8, 0x1d, 0x00}; \f[I]// [28(\(dqx\(dq), 29(0)]\f[R]
\f[B]auto\f[R] const doc = nlohmann::json::from_cbor(bytes, \f[B]true\f[R], \f[B]true\f[R], nlohmann::json::cbor_tag_handler_t::ignore);
\f[I]// doc is [\(dqx\(dq, 0]: the tags are dropped, 29(0) stays the number 0\f[R]
.EE
.SS libcbor
libcbor has no shared values.
It gives tag 29 as a tag item around the number 0.
.IP
.EX
std::uint8_t const bytes[] = {0x82, 0xd8, 0x1c, 0x61, \(aqx\(aq, 0xd8, 0x1d, 0x00}; \f[I]// [28(\(dqx\(dq), 29(0)]\f[R]
cbor_load_result result;
cbor_item_t *doc = cbor_load(bytes, \f[B]sizeof\f[R] bytes, &result);
cbor_item_t *second = cbor_array_handle(doc)[1];
bool const is_tag = cbor_isa_tag(second) && cbor_tag_value(second) == 29;
\f[I]// the second element stays tag 29 around the number 0\f[R]
cbor_decref(&doc);
.EE
.SS FlatBuffers
FlatBuffers is not CBOR and has no tag 28.
A builder can store one offset in two places, and both places read the
same bytes.
.IP
.EX
flatbuffers::FlatBufferBuilder b;
\f[B]auto\f[R] const x = b.CreateString(\(dqx\(dq);
b.Finish(fb::CreateNames(b, b.CreateVector(std::vector{x, x})));
\f[B]auto\f[R] const *v = flatbuffers::GetRoot<fb::Names>(b.GetBufferPointer())\->values();
bool const same = v\->Get(0) == v\->Get(1);
.EE
.SS Cap\(aqn Proto
This document has no snippet for Cap\(aqn Proto.
Whether Cap\(aqn Proto can point two places at one value was not
checked.
.SS 6. A number array
The input is the numbers 1.5, 2.5 and 3.5 as binary64.
The result is the sum 7.5.
.SS C++ in memory
.IP
.EX
std::vector<double> const store{1.5, 2.5, 3.5};
std::span<double const> const values = store;
double const sum = std::accumulate(values.begin(), values.end(), 0.0);
.EE
.SS mbedded\-cbor
cbor::schema reads the struct from its description, which
CBOR_DEFINE_TYPE writes.
It writes a std::vector as an RFC 8746 typed array.
view gives a typed_array_view, a random access range over the bytes of
the input, with no copy.
.IP
.EX
\f[B]struct\f[R] series {
    std::vector<double> values;
};

CBOR_DEFINE_TYPE_MEMBERS(series, cbor::tag{1900}, values);

\f[B]auto\f[R] const root = cbor::schema<series>::path(std::move(bytes));
\f[B]auto\f[R] const values = root\->view<\(dq$.values\(dq>();
double const sum = std::accumulate(values\->begin(), values\->end(), 0.0);
.EE
.SS nlohmann/json
get<std::vector>() copies the numbers out of the tree.
.IP
.EX
\f[B]auto\f[R] const values = nlohmann::json::from_cbor(bytes).get<std::vector<double>>();
double const sum = std::accumulate(values.begin(), values.end(), 0.0);
.EE
.SS libcbor
The input of this snippet holds the numbers as binary16, because they
fit.
cbor_float_get_float reads each width.
.IP
.EX
cbor_load_result result;
cbor_item_t *doc = cbor_load(bytes, \f[B]sizeof\f[R] bytes, &result);
double sum = 0;
\f[B]for\f[R] (std::size_t i = 0; i < cbor_array_size(doc); i++)
    sum += cbor_float_get_float(cbor_array_handle(doc)[i]);
cbor_decref(&doc);
.EE
.SS FlatBuffers
.IP
.EX
\f[B]auto\f[R] const *values = flatbuffers::GetRoot<fb::Doubles>(buf)\->values();
double const sum = std::accumulate(values\->begin(), values\->end(), 0.0);
.EE
.SS Cap\(aqn Proto
.IP
.EX
capnp::FlatArrayMessageReader reader(words);
\f[B]auto\f[R] const values = reader.getRoot<Doubles>().getValues();
double const sum = std::accumulate(values.begin(), values.end(), 0.0);
.EE
.SS 7. Broken input and errors
The input stops before its end.
Each snippet tells that the input is broken.
.SS C++ in memory
Data in memory is not parsed.
The snippet shows the standard form of an error: a std::expected.
.IP
.EX
\f[B]auto\f[R] const parse = [](std::string const &s) \-> std::expected<int, std::errc> {
    \f[B]if\f[R] (s.empty())
        \f[B]return\f[R] std::unexpected(std::errc::invalid_argument);
    \f[B]return\f[R] std::stoi(s);
};
\f[B]auto\f[R] const r = parse(\(dq\(dq);
.EE
.SS mbedded\-cbor
Each read gives a std::expected<T, cbor::error>.
A wrong use that the compiler cannot see throws std::logic_error
(basics.md).
.IP
.EX
\f[I]// bytes: [1, 2] without its last byte\f[R]
\f[B]auto\f[R] const r = cbor::at_path<\(dq$[1]\(dq, std::int64_t>(bytes);
bool const broken = !r && r.error() == cbor::error::too_little_data;
.EE
.SS nlohmann/json
.IP
.EX
std::vector<std::uint8_t> const cut{0x82, 0x01};
\f[B]auto\f[R] const doc = nlohmann::json::from_cbor(cut, \f[B]true\f[R], \f[B]false\f[R]);
bool const broken = doc.is_discarded();
\f[I]// with allow_exceptions true: nlohmann::json::parse_error\f[R]
.EE
.SS libcbor
.IP
.EX
std::uint8_t const cut[] = {0x82, 0x01};
cbor_load_result result;
cbor_item_t *doc = cbor_load(cut, \f[B]sizeof\f[R] cut, &result);
bool const broken = doc == \f[B]nullptr\f[R] && result.error.code == CBOR_ERR_NOTENOUGHDATA;
.EE
.SS FlatBuffers
\f[CR]whole\f[R] holds a complete Person buffer.
.IP
.EX
std::vector<std::uint8_t> const cut(whole.begin(), whole.end() \- 8);
flatbuffers::Verifier verifier(cut.data(), cut.size());
bool const broken = !verifier.VerifyBuffer<fb::Person>(\f[B]nullptr\f[R]);
\f[I]// without the Verifier, GetRoot reads the cut buffer with no check\f[R]
.EE
.SS Cap\(aqn Proto
\f[CR]whole\f[R] holds a complete Person message.
A read of a broken message throws kj::Exception.
.IP
.EX
\f[B]auto\f[R] const cut = whole.asPtr().slice(0, whole.size() \- 1);
bool broken = \f[B]false\f[R];
\f[B]try\f[R] {
    capnp::FlatArrayMessageReader reader(cut);
    (void)reader.getRoot<Person>().getName();
} \f[B]catch\f[R] (kj::Exception const &) {
    broken = \f[B]true\f[R];
}
.EE
