.TE
.SS Read one field
.IP
.EX
\f[I]// mbedded\-cbor; bytes: {\(dquser\(dq: {\(dqid\(dq: 42}}\f[R]
\f[B]auto\f[R] const id = cbor::at_path<\(dq$.user.id\(dq, std::int64_t>(bytes);   \f[I]// *id == 42\f[R]
.EE
.IP
.EX
\f[I]// nlohmann/json\f[R]
nlohmann::json const doc = nlohmann::json::from_cbor(bytes);
int const id = doc.at(\(dquser\(dq).at(\(dqid\(dq).get<int>();
.EE
.SS Write a struct and read it back
.IP
.EX
\f[I]// mbedded\-cbor\f[R]
\f[B]struct\f[R] person {
    std::string name;
    int age;
};

\f[B]auto\f[R] bytes = cbor::structs<person>::encode(person{\(dqann\(dq, 30});
\f[B]auto\f[R] const back = cbor::structs<person>::decode(std::move(*bytes));
\f[I]// (*back)\->name is \(dqann\(dq, (*back)\->age is 30\f[R]
.EE
.IP
.EX
\f[I]// nlohmann/json\f[R]
\f[B]struct\f[R] person {
    std::string name;
    int age;
};
NLOHMANN_DEFINE_TYPE_NON_INTRUSIVE(person, name, age)

std::vector<std::uint8_t> const bytes = nlohmann::json::to_cbor(person{\(dqann\(dq, 30});
person const back = nlohmann::json::from_cbor(bytes).get<person>();
.EE
.PP
\f[CR]encode\f[R] and \f[CR]decode\f[R] return a
\f[CR]std::expected\f[R], and \f[CR]*\f[R] takes the value (structs.md).
.SS Broken input
.IP
.EX
\f[I]// mbedded\-cbor; bytes: [1, 2] without its last byte\f[R]
\f[B]auto\f[R] const r = cbor::at_path<\(dq$[1]\(dq, std::int64_t>(bytes);
bool const broken = !r && r.error() == cbor::error::too_little_data;
.EE
.IP
.EX
\f[I]// nlohmann/json\f[R]
\f[B]auto\f[R] const doc = nlohmann::json::from_cbor(bytes, \f[B]true\f[R], \f[B]false\f[R]);
bool const broken = doc.is_discarded();
.EE
